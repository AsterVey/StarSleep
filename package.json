{
  "name": "star-sleep",
  "version": "1.10.0",
  "private": true,
  "description": "星枢 StarNexus · Agent 工作台与社区美化工坊",
  "author": {
    "name": "AsterVey",
    "url": "https://github.com/AsterVey"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-release.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder --win nsis --x64",
    "qa": "node scripts/qa-v13.cjs",
    "qa:performance": "node scripts/qa-performance-v13.cjs",
    "qa:upgrade": "node scripts/qa-upgrade-v13.cjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "qa:regression": "node scripts/qa-v12.cjs"
  },
  "dependencies": {
    "@fontsource/rajdhani": "^5.2.8",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smol-toml": "1.8.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@ccusage/ccusage-win32-x64": "20.0.24",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "local.starsleep.desktop",
    "productName": "星枢",
    "directories": {
      "output": "release/v1.10.0",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icon.png",
      "resources/icon.ico",
      "resources/agent-hook.ps1",
      "resources/dsh-starsleep/**/*",
      "resources/wallpapers/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "星枢",
      "deleteAppDataOnUninstall": false,
      "artifactName": "StarNexus-Setup-${version}.${ext}",
      "runAfterFinish": false,
      "license": "LICENSE"
    },
    "npmRebuild": false,
    "copyright": "Copyright © 2026 AsterVey",
    "extraResources": [
      {
        "from": "node_modules/@ccusage/ccusage-win32-x64/bin/ccusage.exe",
        "to": "ccusage/ccusage.exe"
      },
      {
        "from": "resources/licenses/ccusage-MIT.txt",
        "to": "ccusage/LICENSE.txt"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/AsterVey/StarSleep.git"
  },
  "homepage": "https://github.com/AsterVey/StarSleep#readme",
  "bugs": {
    "url": "https://github.com/AsterVey/StarSleep/issues"
  }
}
